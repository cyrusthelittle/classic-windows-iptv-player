<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/artifacts/**</DefaultItemExcludes>
    <UpdateTrustPath Condition="'$(UpdateTrustPath)' == ''">$(MSBuildThisFileDirectory)UpdateTrust.pem</UpdateTrustPath>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(UpdateTrustPath)')">
    <EmbeddedResource Include="$(UpdateTrustPath)" LogicalName="UpdateTrust.pem" />
  </ItemGroup>
</Project>
