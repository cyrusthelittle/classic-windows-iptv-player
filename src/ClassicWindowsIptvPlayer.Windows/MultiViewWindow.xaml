<Window x:Class="ClassicWindowsIptvPlayer.Windows.MultiViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Multi-view" Width="1100" Height="720" MinWidth="640" MinHeight="420"
        Background="#111827" Foreground="White" Closed="Window_Closed">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" FontSize="20" FontWeight="SemiBold"
                   Text="Multi-view — choose a live channel for each tile" />
        <UniformGrid x:Name="TilesGrid" Columns="2" Rows="2" />
    </DockPanel>
</Window>
