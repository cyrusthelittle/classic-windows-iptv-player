<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Classic Windows IPTV Player</AssemblyName>
    <RootNamespace>ClassicWindowsIptvPlayer.Windows</RootNamespace>
    <Version>0.9.0</Version>
    <FileVersion>0.9.0.0</FileVersion>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <BundleVlc Condition="'$(BundleVlc)' == ''">true</BundleVlc>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ApplicationIcon>Assets\ClassicWindowsIptvPlayer.ico</ApplicationIcon>
    <!-- App is x64-only; skip bundling the x86/arm64 native LibVLC binaries (~180 MB) -->
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <!-- App UI is English-only; skip the localized WPF resource DLLs (13 language folders) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages><DefaultItemExcludes>$(DefaultItemExcludes);**/artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- Not needed at runtime: .lib link stubs, binaural-audio profiles, and lua scripts
         (site-specific playlist parsers; IPTV playlists are parsed by ClassicWindowsIptvPlayer.Core).
         %2A is an escaped '*' so the wildcard expands against the LibVLC package folder. -->
    <VlcWindowsX64ExcludeFiles Include="libvlc.lib;libvlccore.lib;hrtfs\%2A%2A;lua\%2A%2A" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\ClassicWindowsIptvPlayer.ico" />
    <Resource Include="Assets\iptv-logo.png" />
    <!-- Update edition: a Lite install downloads the Lite update, a Full install the Full update. -->
    <AssemblyMetadata Include="UpdateEdition" Value="lite" Condition="'$(BundleVlc)' == 'false'" />
    <AssemblyMetadata Include="UpdateEdition" Value="full" Condition="'$(BundleVlc)' != 'false'" />
    <Content Include="Assets\LiteStartHere.txt" Condition="'$(BundleVlc)' == 'false' and '$(SelfContained)' != 'true'"
             Link="Read Me First!!!.txt" CopyToPublishDirectory="Always" />
    <ProjectReference Include="..\ClassicWindowsIptvPlayer.Core\ClassicWindowsIptvPlayer.Core.csproj" /><ProjectReference Include="..\ClassicWindowsIptvPlayer.Updater\ClassicWindowsIptvPlayer.Updater.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.7.1" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.7.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="'$(BundleVlc)' == 'true'" />
  </ItemGroup>
  <Target Name="CopyUpdaterHelper" AfterTargets="Build">
    <ItemGroup><UpdaterFiles Include="../ClassicWindowsIptvPlayer.Updater/bin/$(Configuration)/net10.0-windows/win-x64/ClassicWindowsIptvPlayer.Updater.*" /></ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(TargetDir)" />
  </Target>
  <Target Name="PublishUpdaterHelper" AfterTargets="Publish">
    <!-- Both apps use the same runtime files in this publish directory. -->
    <Error Condition="'$(PublishSingleFile)' == 'true'" Text="Publish the player with PublishSingleFile=false so the player and updater share their runtime files." />
    <MSBuild Projects="../ClassicWindowsIptvPlayer.Updater/ClassicWindowsIptvPlayer.Updater.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(PublishDir);SelfContained=$(SelfContained);RuntimeIdentifier=win-x64;PublishSingleFile=false" />
  </Target></Project>
