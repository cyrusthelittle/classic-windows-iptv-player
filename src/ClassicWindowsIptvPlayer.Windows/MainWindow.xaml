<Window x:Class="ClassicWindowsIptvPlayer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Classic Windows IPTV Player"
        Width="1480" Height="900"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource Bg0Brush}"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopMenuRow" Height="48" />
            <RowDefinition x:Name="ContentRow" Height="*" />
            <RowDefinition x:Name="StatusRow" Height="28" />
        </Grid.RowDefinitions>

        <Menu x:Name="AppMenu" Grid.Row="0" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource Text0Brush}">
            <MenuItem Header="Account">
                <MenuItem Header="Information" Click="AccountInfo_Click" />
                <MenuItem Header="Export organization (no credentials)..." Click="ExportOrganization_Click" />
                <MenuItem Header="Import organization..." Click="ImportOrganization_Click" />
                <MenuItem Header="Back up local data..." Click="BackupLocalData_Click" />
                <MenuItem Header="Restore local data..." Click="RestoreLocalData_Click" />
                <MenuItem Header="Restore hidden items..." Click="RestoreHiddenItems_Click" />
                <Separator />
                <MenuItem Header="Logout / Change account" Click="ChangeAccount_Click" />
            </MenuItem>
            <MenuItem Header="Playlist">
                <MenuItem Header="Retry provider / update playlist" Click="UpdatePlaylist_Click" />
                <MenuItem Header="Use saved library" Click="UseSavedLibrary_Click" />
                <MenuItem x:Name="RefreshEpgMenuItem" Header="Refresh programme guide" Click="RefreshEpg_Click" />
                <MenuItem Header="Clear cache" Click="ClearCache_Click" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Show / hide channels   Ctrl+L" Click="ToggleChannels_Click" />
                <MenuItem Header="Full screen   F11" Click="FullScreen_Click" />
                <MenuItem Header="Mini player" Click="MiniPlayer_Click" />
                <MenuItem Header="Show diagnostics" IsCheckable="True" Click="ToggleDiagnostics_Click" />
            </MenuItem>
            <MenuItem Header="Playback">
                <MenuItem Header="Play / pause   Space" Click="PlayPause_Click" />
                <MenuItem Header="Stop   S" Click="Stop_Click" />
                <MenuItem Header="Previous   Left" Click="Previous_Click" />
                <MenuItem Header="Next   Right" Click="Next_Click" />
                <Separator />
                <MenuItem x:Name="GoLiveMenuItem" Header="Go live" Click="GoLive_Click" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Restart stream" Click="RestartStream_Click" />
                <MenuItem Header="Copy selected stream URL" Click="CopyStreamUrl_Click" />
                <Separator />
                <MenuItem Header="Favorite / unfavorite selected" Click="ToggleFavorite_Click" />
            </MenuItem>
            <MenuItem x:Name="SubtitleMenu" Header="Subtitles" />
            <MenuItem x:Name="PlaybackPreferencesMenu" Header="Playback" SubmenuOpened="PlaybackPreferencesMenu_Opened"><MenuItem Header="Available during playback" IsEnabled="False" /></MenuItem>
            <MenuItem Header="Settings">
                <MenuItem Header="Buffer 1 sec" Click="Buffer1_Click" />
                <MenuItem Header="Buffer 3 sec" Click="Buffer3_Click" />
                <MenuItem Header="Buffer 6 sec" Click="Buffer6_Click" />
                <MenuItem Header="Buffer 10 sec" Click="Buffer10_Click" />
                    <Separator />
                    <MenuItem Header="Reconnect attempts">
                        <MenuItem Header="5 attempts" Click="Reconnect5_Click" />
                        <MenuItem Header="10 attempts (default)" Click="Reconnect10_Click" />
                        <MenuItem Header="15 attempts" Click="Reconnect15_Click" />
                        <MenuItem Header="20 attempts" Click="Reconnect20_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="DarkModeMenuItem" Header="Dark mode" IsCheckable="True" Click="ToggleDarkMode_Click" />
                    <MenuItem x:Name="EpgEnabledMenuItem" Header="Programme guide (EPG)" IsCheckable="True" Click="ToggleEpg_Click" />
                    <MenuItem x:Name="UpdateChecksMenuItem" Header="Check for updates on startup" IsCheckable="True" Click="ToggleUpdateChecks_Click" />
                    <Separator />
                    <MenuItem Header="OSD opacity (controls + volume)">
                        <MenuItem Header="Enter percentage..." Click="SetCustomOsdOpacity_Click" />
                        <Separator />
                        <MenuItem Header="100%" Tag="1.0" Click="SetOsdOpacity_Click" />
                        <MenuItem Header="90%" Tag="0.9" Click="SetOsdOpacity_Click" />
                        <MenuItem Header="80%" Tag="0.8" Click="SetOsdOpacity_Click" />
                        <MenuItem Header="70%" Tag="0.7" Click="SetOsdOpacity_Click" />
                        <MenuItem Header="60%" Tag="0.6" Click="SetOsdOpacity_Click" />
                    </MenuItem>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem x:Name="CheckForUpdatesMenuItem" Header="Check for updates..." Click="CheckForUpdates_Click" />
                <Separator />
                <MenuItem Header="GitHub" Click="GitHub_Click" />
                <MenuItem Header="About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="360" MinWidth="260" />
                <ColumnDefinition x:Name="SplitterColumn" Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Image Source="Assets/iptv-logo.png"
                                       Width="32" Height="32"
                                       Margin="0,0,10,0"
                                       Stretch="Uniform" />
                                <TextBlock Text="Library" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button x:Name="NewFavoriteFolderButton" Style="{StaticResource GhostButton}" Content="New folder" Visibility="Collapsed" Margin="0,0,10,0" Padding="10,5" Click="NewFavoriteFolder_Click" />
                                <Button x:Name="FolderBackButton"
                                        Style="{StaticResource GhostButton}"
                                        Content="Back"
                                        Visibility="Collapsed"
                                        Margin="0,0,10,0"
                                        Padding="10,5"
                                        Click="FolderBack_Click" />
                                <TextBlock x:Name="CountText" Text="0" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Windows-Explorer-style path (e.g. "Series / Persian Series Foreign / Cape Fear 2026").
                             On its own row so a long folder/series name can never crowd out the Back button above.
                             Populated in code-behind (UpdateBreadcrumb) since each segment needs its own click handler. -->
                        <WrapPanel x:Name="BreadcrumbPanel" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Search (Ctrl+F)" Foreground="{DynamicResource Text1Brush}" Margin="0,0,0,4" />
                            <DockPanel LastChildFill="True">
                                <Button x:Name="ClearSearchButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear" Click="ClearSearch_Click" Margin="6,0,0,0" />
                                <TextBox x:Name="SearchBox" Height="38" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search current library" />
                            </DockPanel>
                            <TextBlock x:Name="SearchScopeText" Foreground="{DynamicResource Text2Brush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SearchFoldersButton" Grid.Column="0" Style="{StaticResource GhostButton}" Content="Folders" ToolTip="Browse by category folders" Click="SearchFolders_Click" />
                            <Button x:Name="SearchLettersButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="A-Z" ToolTip="Browse alphabetically (A-Z, 0-9)" Click="SearchLetters_Click" />
                            <Button x:Name="SearchItemsButton" Grid.Column="4" Style="{StaticResource GhostButton}" Content="Items" ToolTip="Show all items" Click="SearchItems_Click" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AllMediaButton" Grid.Column="0" Style="{StaticResource GhostButton}" Content="All" Click="AllMedia_Click" />
                            <Button x:Name="LiveTvButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Live TV" Click="LiveTv_Click" />
                            <Button x:Name="MoviesButton" Grid.Column="4" Style="{StaticResource GhostButton}" Content="Movies" Click="Movies_Click" />
                            <Button x:Name="SeriesButton" Grid.Column="6" Style="{StaticResource GhostButton}" Content="Series" Click="Series_Click" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AllViewButton" Grid.Column="0" Style="{StaticResource GhostButton}" Content="All" Click="AllView_Click" />
                            <Button x:Name="FavoritesViewButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Favorites" ToolTip="Right-click a channel to add it to a favorite folder" Click="FavoritesView_Click" />
                            <Button x:Name="RecentViewButton" Grid.Column="4" Style="{StaticResource GhostButton}" Content="Recent" Click="RecentView_Click" />
                            <Button x:Name="ContinueViewButton" Grid.Column="6" Style="{StaticResource GhostButton}" Content="Continue" ToolTip="Unfinished movies and episodes" Click="ContinueView_Click" />
                        </Grid>

                        <ComboBox x:Name="SeasonPicker" Margin="0,8,0,0" Visibility="Collapsed"
                                  SelectionChanged="SeasonPicker_SelectionChanged" AutomationProperties.Name="Series season" />
                        <ComboBox x:Name="VodSortPicker" Margin="0,8,0,0" Visibility="Collapsed" SelectedIndex="0"
                                  SelectionChanged="VodSortPicker_SelectionChanged" AutomationProperties.Name="Sort movies and series">
                            <ComboBoxItem Content="Provider order" />
                            <ComboBoxItem Content="Title A-Z" />
                            <ComboBoxItem Content="Recently added" />
                            <ComboBoxItem Content="Year (newest)" />
                            <ComboBoxItem Content="Duration (longest)" />
                        </ComboBox>
                        <Button x:Name="VodDetailsButton" Margin="0,8,0,0" Visibility="Collapsed" Content="Selected item details"
                                Style="{StaticResource GhostButton}" Click="VodDetails_Click" AutomationProperties.Name="Details for selected movie or series" />

                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                            <Button x:Name="ResetFiltersButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Reset filters" Click="ResetFilters_Click" />
                            <TextBlock x:Name="FilterScopeText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text2Brush}" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </StackPanel>

                    <Grid Grid.Row="3">
                    <ListBox x:Name="ChannelList" SelectionChanged="ChannelList_SelectionChanged" MouseDoubleClick="ChannelList_MouseDoubleClick" ContextMenuOpening="ChannelList_ContextMenuOpening" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Library items">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="48" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <ContentControl Content="{Binding Icon}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource PanelBrush}"
                                                CornerRadius="3"
                                                Padding="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Logo}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Source="{Binding Logo, NotifyOnTargetUpdated=True}"
                                                   Stretch="Uniform"
                                                   ImageFailed="ChannelLogo_ImageFailed"
                                                   TargetUpdated="ChannelLogo_TargetUpdated" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{Binding Group}" FontSize="12" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="EmptyStatePanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" Padding="16" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock x:Name="EmptyStateText" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Button x:Name="EmptyStateAction" Style="{StaticResource PrimaryButton}" Content="Reset filters" HorizontalAlignment="Left" Click="EmptyStateAction_Click" />
                        </StackPanel>
                    </Border>
                    </Grid>
                    <Border x:Name="BrowseGuidePanel" Grid.Row="4" Margin="0,8,0,0" Padding="8" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="SELECTED CHANNEL GUIDE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}" />
                            <TextBlock x:Name="BrowseGuideState" TextWrapping="Wrap" Margin="0,3,0,3" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="BrowseNowButton" Content="Now: —" Click="BrowseProgramme_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2,0,0" />
                            <Button x:Name="BrowseNextButton" Content="Next: —" Click="BrowseProgramme_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2,0,0" />
                            <WrapPanel Margin="0,5,0,0">
                                <Button x:Name="GuideRefreshButton" Content="Refresh" Click="RefreshEpg_Click" Style="{StaticResource GhostButton}" Margin="0,0,5,0" />
                                <Button x:Name="GuideCancelButton" Content="Cancel" Click="CancelEpg_Click" Style="{StaticResource GhostButton}" Margin="0,0,5,0" />
                                <Button x:Name="GuideMapButton" Content="Map / time" Click="GuideMap_Click" Style="{StaticResource GhostButton}" />
                                <Button x:Name="GuideGridButton" Content="Open guide grid" Click="GuideGrid_Click" Style="{StaticResource GhostButton}" Margin="5,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource StrokeBrush}" />

            <Grid x:Name="PlayerGrid" Grid.Column="2" Background="Black" SizeChanged="PlayerGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="VideoRow" Height="*" />
                    <RowDefinition x:Name="ControlsRow" Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="VideoHost" Background="Black" MouseLeftButtonDown="VideoHost_MouseLeftButtonDown">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Play / Pause" Click="PlayPause_Click" />
                            <MenuItem Header="Stop" Click="Stop_Click" />
                            <MenuItem Header="Previous" Click="Previous_Click" />
                            <MenuItem Header="Next" Click="Next_Click" />
                            <Separator />
                            <MenuItem Header="Full screen" Click="FullScreen_Click" />
                            <MenuItem Header="Mini player" Click="MiniPlayer_Click" />
                            <MenuItem x:Name="VideoGoLiveMenuItem" Header="Go live" Click="GoLive_Click" IsEnabled="False" />
                            <MenuItem Header="Restart stream" Click="RestartStream_Click" />
                            <MenuItem Header="Copy stream URL" Click="CopyStreamUrl_Click" />
                            <MenuItem Header="Favorite / unfavorite" Click="ToggleFavorite_Click" />
                            <Separator />
                            <MenuItem x:Name="VideoSubtitleMenu" Header="Subtitles" />
                            <Separator />
                            <MenuItem Header="Show stream information" Click="ShowStreamInfo_Click" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid x:Name="MainVideoSurfacePanel">
                        <!-- The idle background must never be layered over a visible
                             video host: LibVLC renders into a native child window that
                             always paints on top of WPF content in the same area. The
                             code-behind therefore keeps the video host collapsed while idle
                             and swaps these two on play/stop. -->
                        <Grid x:Name="IdleBackground" Background="#0B0F19">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                <Image Source="Assets/iptv-logo.png"
                                       Width="120" Height="120"
                                       Stretch="Uniform"
                                       Opacity="0.9" />
                                <TextBlock x:Name="IdleBackgroundText"
                                           Text="Select a channel to start watching"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,18,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="16"
                                           Foreground="#8E97AE" />
                            </StackPanel>
                        </Grid>

                        <!-- A persistent WinForms HWND is assigned before Play, preventing
                             VLC from falling back to a top-level Direct3D11 output window. -->
                        <wfi:WindowsFormsHost x:Name="VideoViewHost" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Popup x:Name="VolumeOsdPopup"
                       PlacementTarget="{Binding ElementName=VideoHost}"
                       Placement="Relative"
                       HorizontalOffset="10"
                       VerticalOffset="10"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       IsHitTestVisible="False">
                    <Border x:Name="VolumeOsdBorder"
                            Background="#DD000000"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="22,12">
                        <TextBlock x:Name="VolumeOsdText"
                                   Text="Volume 100%"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                    </Border>
                </Popup>

                <Popup x:Name="FullScreenControlsPopup"
                       PlacementTarget="{Binding ElementName=VideoHost}"
                       Placement="Relative"
                       AllowsTransparency="True"
                       StaysOpen="True" />

                <Border x:Name="ControlsBar" Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,1,0,0" Padding="8" MouseEnter="ControlsBar_MouseEnter">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Slider x:Name="SeekSlider" Minimum="0" Maximum="1000" ValueChanged="SeekSlider_ValueChanged" PreviewMouseDown="SeekSlider_PreviewMouseDown" PreviewMouseUp="SeekSlider_PreviewMouseUp" Margin="0,0,0,8" />

                        <DockPanel Grid.Row="1" LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="ToggleChannelsButton" Style="{StaticResource GhostButton}" Width="42" ToolTip="Show or hide channels" Click="ToggleChannels_Click" />
                                <Button x:Name="PreviousButton" Style="{StaticResource GhostButton}" Width="42" Margin="8,0,0,0" ToolTip="Previous channel" Click="Previous_Click" />
                                <Button x:Name="PlayPauseButton" Style="{StaticResource PrimaryButton}" Width="54" Margin="8,0,0,0" ToolTip="Play or pause" Click="PlayPause_Click" />
                                <Button x:Name="StopButton" Style="{StaticResource GhostButton}" Width="42" Margin="8,0,0,0" ToolTip="Stop" Click="Stop_Click" />
                                <Button x:Name="NextButton" Style="{StaticResource GhostButton}" Width="42" Margin="8,0,0,0" ToolTip="Next channel" Click="Next_Click" />
                                <Button x:Name="MorePlaybackButton" Style="{StaticResource GhostButton}" Content="More" Margin="8,0,0,0" Click="MorePlayback_Click" AutomationProperties.Name="More playback actions">
                                    <Button.ContextMenu>
                                        <ContextMenu Opened="MorePlaybackMenu_Opened">
                                            <MenuItem x:Name="MorePlaybackPreferencesMenu" Header="Playback preferences" SubmenuOpened="PlaybackPreferencesMenu_Opened"><MenuItem Header="Available during playback" IsEnabled="False" /></MenuItem>
                                            <MenuItem Header="Mini player" Click="MiniPlayer_Click" />
                                            <MenuItem Header="Restart stream" Click="RestartStream_Click" />
                                            <MenuItem Header="Previous channel" Click="Previous_Click" />
                                            <MenuItem Header="Next channel" Click="Next_Click" />
                                            <MenuItem Header="Favorite / unfavorite selected" Click="ToggleFavorite_Click" />
                                            <MenuItem Header="Copy playing stream URL" Click="CopyStreamUrl_Click" />
                                            <MenuItem Header="Stream information" Click="ShowStreamInfo_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="RetryPlaybackButton" Style="{StaticResource PrimaryButton}" Content="Retry" Margin="8,0,0,0" Visibility="Collapsed" Click="RestartStream_Click" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TimeText" Text="00:00 / 00:00" VerticalAlignment="Center" Foreground="{DynamicResource Text1Brush}" Margin="0,0,12,0" />
                                <Button x:Name="MuteButton" Style="{StaticResource GhostButton}" Width="46" ToolTip="Mute" Click="Mute_Click" />
                                <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="150" Value="100" ValueChanged="VolumeSlider_ValueChanged" Margin="10,0,16,0" />
                                <Button x:Name="FullScreenButton" Style="{StaticResource GhostButton}" Width="46" ToolTip="Full screen" Click="FullScreen_Click" />
                            </StackPanel>

                            <TextBlock x:Name="NowPlayingText" Text="Select a channel to play" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Text1Brush}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <Border x:Name="EpgPanel" Grid.Row="2" Margin="0,6,0,0" Padding="8,5" CornerRadius="5"
                                Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="NOW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}" />
                                    <TextBlock x:Name="EpgNowText" Text="Programme guide loading..." FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="NEXT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}" />
                                    <TextBlock x:Name="EpgNextText" Text="—" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Buffer" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" Margin="0,0,8,0" />
                            <ComboBox x:Name="BufferBox" Grid.Column="1" SelectionChanged="BufferBox_SelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource InputLightTextBrush}" />
                                </Style>
                            </ComboBox.Resources>
                                <ComboBoxItem Content="1 sec" Tag="1000" />
                                <ComboBoxItem Content="3 sec" Tag="3000" />
                                <ComboBoxItem Content="6 sec" Tag="6000" />
                                <ComboBoxItem Content="10 sec" Tag="10000" />
                            </ComboBox>
                            <TextBlock x:Name="LiveDelayText" Grid.Column="2" Text="" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource Text2Brush}" FontWeight="SemiBold" Margin="12,0,0,0" Visibility="Collapsed" />
                            <Button x:Name="GoLiveButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Go Live" Margin="8,0,0,0" ToolTip="Jump to live edge" Click="GoLive_Click" Visibility="Collapsed" />
                            <Button x:Name="RestartButton" Grid.Column="4" Style="{StaticResource GhostButton}" Margin="8,0,0,0" ToolTip="Restart stream" Click="RestartStream_Click" />
                            <Button x:Name="CopyUrlButton" Grid.Column="5" Style="{StaticResource GhostButton}" Margin="8,0,0,0" ToolTip="Copy stream URL" Click="CopyStreamUrl_Click" />
                            <Button x:Name="FavoriteButton" Grid.Column="6" Style="{StaticResource GhostButton}" Width="42" Margin="8,0,0,0" ToolTip="Favorite" Click="ToggleFavorite_Click" />
                        </Grid>

                        <TextBlock x:Name="StreamInfoText"
                                   Grid.Row="4"
                                   Text="State: Not ready | Resolution: detecting | Bandwidth: detecting | FPS: detecting | Video codec: detecting | Audio codec: detecting | Audio: detecting"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource Text2Brush}"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <StatusBar x:Name="MainStatusBar" Grid.Row="2" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource Text0Brush}">
            <TextBlock x:Name="StatusText" Text="Ready" />
        </StatusBar>

        <!-- Keep this as the last child so account startup/switching cannot look
             frozen while networking, cache parsing, and indexing are in flight. -->
        <Grid x:Name="AccountLoadingOverlay"
              Grid.RowSpan="3"
              Panel.ZIndex="1000"
              Background="{DynamicResource OverlayScrimBrush}"
              IsHitTestVisible="True">
            <Border Width="440"
                    Padding="42,38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="24">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="14">
                        <Ellipse x:Name="LoadingDot1" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource AccentBrush}" />
                        <Ellipse x:Name="LoadingDot2" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource AccentBrush}" Opacity="0.25" />
                        <Ellipse x:Name="LoadingDot3" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource AccentBrush}" Opacity="0.25" />
                        <Ellipse x:Name="LoadingDot4" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource AccentBrush}" Opacity="0.25" />
                    </StackPanel>

                    <TextBlock Text="Please wait"
                               Margin="0,24,0,0"
                               HorizontalAlignment="Center"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text0Brush}" />
                    <TextBlock x:Name="AccountLoadingMessage"
                               Text="Opening your account..."
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="15"
                               Foreground="{DynamicResource Text2Brush}" />
                    <TextBlock Text="This may take a moment for larger playlists."
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text2Brush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Content="Cancel" Click="CancelLibraryLoad_Click" Margin="0,0,8,0" Padding="12,6" />
                        <Button Content="Retry" Click="RetryLibraryLoad_Click" Margin="0,0,8,0" Padding="12,6" />
                        <Button Content="Use saved library" Click="UseSavedLibrary_Click" Padding="12,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
