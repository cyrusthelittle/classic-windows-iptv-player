<Window x:Class="CyrusIptv.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyrus IPTV Login"
        Width="780" Height="660"
        MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource Bg0Brush}">
    <Grid Margin="28">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="22" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Cyrus IPTV" FontSize="32" FontWeight="Bold" />
                    <TextBlock Text="Modern Windows player shell" Foreground="{StaticResource Text2Brush}" Margin="0,6,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,24,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="AccountsList"
                             Grid.Row="0"
                             SelectionChanged="AccountsList_SelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" Content="Add" Margin="0,0,6,0" Click="AddAccount_Click" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Remove" Margin="6,0,0,0" Click="RemoveAccount_Click" />
                    </Grid>

                    <ScrollViewer Grid.Column="2"
                                  Grid.RowSpan="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,12,0">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Account Name" Foreground="{StaticResource Text1Brush}" Margin="0,0,0,6" />
                        <TextBox x:Name="AccountNameBox" Height="38" Margin="0,0,0,14" />

                        <TextBlock Text="Server URL" Foreground="{StaticResource Text1Brush}" Margin="0,0,0,6" />
                        <TextBox x:Name="ServerUrlBox" Height="38" Margin="0,0,0,14" />

                        <TextBlock Text="Username" Foreground="{StaticResource Text1Brush}" Margin="0,0,0,6" />
                        <TextBox x:Name="UsernameBox" Height="38" Margin="0,0,0,14" />

                        <TextBlock Text="Password" Foreground="{StaticResource Text1Brush}" Margin="0,0,0,6" />
                        <PasswordBox x:Name="PasswordBox" Height="38" Margin="0,0,0,14" />

                        <Button Style="{StaticResource GhostButton}" Content="Save Account" Height="36" Margin="0,0,0,14" Click="SaveAccount_Click" />
                        <CheckBox x:Name="UpdatePlaylistCheck" Content="Update playlist before opening" Foreground="{StaticResource Text1Brush}" IsChecked="True" />
                        <TextBlock x:Name="StatusText" Text="Use cached playlist for faster startup when you only want to watch." Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                    </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Cancel" Width="110" Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Continue" Width="130" Click="Continue_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
